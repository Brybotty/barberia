# Copia este archivo como .env (despliegue) o .env.local (emuladores) y pon tu llave pública de Wompi.
# Pruebas: pub_test_...   Producción: pub_prod_...   (Wompi → Desarrolladores → Llaves del API)
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR

# Los secretos NO van aquí. En producción se guardan en Secret Manager:
#   firebase functions:secrets:set WOMPI_INTEGRITY_SECRET   (Secretos para integración técnica → Integridad)
#   firebase functions:secrets:set WOMPI_EVENTS_SECRET      (Secretos para integración técnica → Eventos)
# Para los emuladores, créalos en functions/.secret.local:
#   WOMPI_INTEGRITY_SECRET=test_integrity_...
#   WOMPI_EVENTS_SECRET=test_events_...
